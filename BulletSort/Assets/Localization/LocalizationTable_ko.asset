  m_TableData:
  - m_Id: 7930798571520
    m_Localized: "\uC815\uCCB4\uBD88\uBA85\uC758 \uBAAC\uC2A4\uD130\uAC00\\n\uC138\uACC4\uB97C
      \uC704\uD611\uD558\uACE0 \uC788\uC2B5\uB2C8\uB2E4.\\n\uCD1D\uC54C\uC18C\uB140\uB4E4\uC744
      \uC815\uB82C\uD558\uC5EC\\n\uBAAC\uC2A4\uD130\uB97C \uCC98\uCE58\uD574 \uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 7930798571521
    m_Localized: "\uAC19\uC740 \uC885\uB958\uC758 \uCD1D\uC54C\uC18C\uB140\uB97C
      \uC815\uB82C!!\\n\uCD1D\uC54C\uC18C\uB140\uB4E4\uC758 \uD30C\uC6CC\uB85C \uC801\uC744
      \uACF5\uACA9\uD574\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 7930798571522
    m_Localized: "\uCD1D\uC54C\uC18C\uB140\uB97C \uB2E4 \uC815\uB82C\uD558\uBA74\\nPopping
      Blast!!\\n\uBAA8\uB4E0 \uC801\uB4E4\uC5D0\uAC8C \uAC15\uB825\uD55C \uD30C\uC6CC\uB85C
      \uACF5\uACA9\uD574\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 7930806960128
    m_Localized: "\uC804\uD22C \uC911 \uD2B9\uC804 \uC120\uD0DD\uC73C\uB85C \uC804\uB825
      \uAC15\uD654!!\\n\uC120\uD0DD\uD55C \uCD1D\uC54C\uC18C\uB140\uC5D0 \uB9DE\uAC8C
      \uD2B9\uC804\uC774 \uB098\uC640\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 7930806960129
    m_Localized: "\uC77C\uBC18, \uC5D8\uB9AC\uD2B8\\n\uADF8\uB9AC\uACE0 \uC2A4\uD14C\uC774\uC9C0
      \uB9C8\uC9C0\uB9C9\uC5D0\uB294\\n\uAC15\uB825\uD55C \uBCF4\uC2A4\uAC00 \uB4F1\uC7A5\uD574\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 7930806960130
    m_Localized: "\uC2A4\uD14C\uC774\uC9C0\uC5D0\uC11C \uC2B9\uB9AC\uD558\uBA74\\n\uAC15\uD654\uC640
      \uCE90\uB9AD\uD130 \uD68D\uB4DD\uC5D0 \uD544\uC694\uD55C\\n\uC7AC\uD654\uB97C
      \uC0AC\uC6A9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7930806960131
    m_Localized: "\uB371 \uD3B8\uC131\uC5D0\uC11C\uB294\\n\uCD1D\uC54C\uC18C\uB140\uB97C
      \uBC30\uCE58\uD560 \uC218 \uC788\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 7930806960132
    m_Localized: "\uBCF4\uC720\uD55C \uCD1D\uC54C\uC18C\uB140\uB85C \uB371\uC744
      \uAD6C\uC131\uD558\uC138\uC694.\\n6\uBA85\uC758 \uB2E4\uB978 \uC18C\uB140\uB4E4\uB85C
      \uAD6C\uC131\uD560 \uC218 \uC788\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 7930806960133
    m_Localized: "\uCD1D\uC54C \uC18C\uB140\uB4E4\uC758\\n\uACF5\uACA9 \uC720\uD615\uC744
      \uD655\uC778\uD560 \uC218 \uC788\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 7930806960135
    m_Localized: "\uAC15\uD654\uC5D0\uC11C\uB294\\n\uCD1D\uC54C\uC18C\uB140\uB97C
      \uD574\uAE08 \uD558\uACE0\\n\uAC15\uD654 \uD560\uC218 \uC788\uC5B4\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 7930806960136
    m_Localized: "\uD68D\uB4DD\uD55C \uC2A4\uD0C0\uB354\uC2A4\uD2B8 \uCF54\uC5B4\uB97C
      \uC0AC\uC6A9\uD574\uC11C\\n\uCD1D\uC54C\uC18C\uB140\uB97C \uC131\uC7A5 \uC2DC\uCF1C\uC8FC\uC138\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 7930806960138
    m_Localized: "\uAC15\uD654\uAC00 \uC644\uB8CC\uB41C\\n\uCD1D\uC54C\uC18C\uB140\uB97C
      \uD655\uC778\\n\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7930806960139
    m_Localized: Next>
    m_Metadata:
      m_Items: []
  - m_Id: 7930806960140
    m_Localized: End
    m_Metadata:
      m_Items: []
  - m_Id: 7930806960142
    m_Localized: ERROR
    m_Metadata:
      m_Items: []
  - m_Id: 7930806960155
    m_Localized: "\uB370\uC774\uD130\uB97C \uAC00\uC838\uC624\uB294 \uC911\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7930806960157
    m_Localized: "\uD654\uBA74\uC744 \uB204\uB974\uBA74 \uC2DC\uC791"
    m_Metadata:
      m_Items: []
  - m_Id: 7930806960158
    m_Localized: "\uB85C\uB529\uC911...({\uB85C\uB529 \uC9C4\uD589\uB3C4}%)"
    m_Metadata:
      m_Items: []
  - m_Id: 7930806960160
    m_Localized: "\uBC30\uD2C0"
    m_Metadata:
      m_Items: []
  - m_Id: 7930806960161
    m_Localized: '{StageData.StageName}'
    m_Metadata:
      m_Items: []
  - m_Id: 7930806960162
    m_Localized: "\uC2DC\uC791!"
    m_Metadata:
      m_Items: []
  - m_Id: 7930806960164
    m_Localized: "\uC774\uC804 \uB09C\uC774\uB3C4\uB97C \uBA3C\uC800 \uD074\uB9AC\uC5B4
      \uD574\uC57C \uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7930806960165
    m_Localized: "\uB371 \uD3B8\uC131"
    m_Metadata:
      m_Items: []
  - m_Id: 7930806960166
    m_Localized: "\uD3B8\uC131\uB41C \uCD1D\uC54C\uC18C\uB140 (\uC5C6\uC74C)"
    m_Metadata:
      m_Items: []
  - m_Id: 7930806960167
    m_Localized: "\uD3B8\uC131\uB41C \uCD1D\uC54C\uC18C\uB140 ({0}/6)"
    m_Metadata:
      m_Items: []
  - m_Id: 7930806960168
    m_Localized: "\uD3B8\uC131\uB41C \uCD1D\uC54C\uC18C\uB140 (\uC644\uB8CC)"
    m_Metadata:
      m_Items: []
  - m_Id: 7930806960169
    m_Localized: "\uBCF4\uC720\uD55C \uCD1D\uC54C\uC18C\uB140 ({0}\uBA85)"
    m_Metadata:
      m_Items:
      - rid: 8237326941018914919
  - m_Id: 7930806960170
    m_Localized: "\uBBF8\uBCF4\uC720"
    m_Metadata:
      m_Items: []
  - m_Id: 7930806960171
    m_Localized: "<color=blue> \uD3B8\uC131\uC911 </color>"
    m_Metadata:
      m_Items: []
  - m_Id: 7930806960172
    m_Localized: "\uC815\uB82C"
    m_Metadata:
      m_Items: []
  - m_Id: 7930806960173
    m_Localized: "\uACF5\uACA9 \uC720\uD615\uBCF4\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 7930806960174
    m_Localized: "\uAE30\uBCF8"
    m_Metadata:
      m_Items: []
  - m_Id: 7930806960175
    m_Localized: "\uC721\uAC01\uD615 \uCD1D\uC54C\uC18C\uB140\uC785\uB2C8\uB2E4.
      \uBAA8\uB4E0 \uB2A5\uB825\uCE58\uAC00 \uC548\uC815\uC801\uC774\uACE0 \uB4A4\uB5A8\uC5B4\uC9C0\uC9C0\uB3C4
      \uC54A\uC544\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 7930806960176
    m_Localized: "\uC0B0\uD0C4"
    m_Metadata:
      m_Items: []
  - m_Id: 7930806960177
    m_Localized: "\uAC00\uAE4C\uC6B4 \uC801\uC5D0\uAC8C \uB113\uAC8C \uD37C\uC9C0\uB294
      \uD0C4\uD658\uC744 \uBC1C\uC0AC\uD558\uB294 \uCD1D\uC54C\uC18C\uB140\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7930806960178
    m_Localized: "\uC6D0\uAC70\uB9AC"
    m_Metadata:
      m_Items: []
  - m_Id: 7930806960179
    m_Localized: "\uBA40\uB9AC \uC788\uB294 \uC584\uBBF8\uC6B4 \uB140\uC11D\uC744
      \uACF5\uACA9\uD558\uB294 \uB370 \uD2B9\uD654\uB41C \uCD1D\uC54C\uC18C\uB140\uC5D0\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 7930806960180
    m_Localized: "\uD0F1\uCEE4\uB300\uD56D"
    m_Metadata:
      m_Items: []
  - m_Id: 7930806960181
    m_Localized: "\uB2E8\uB2E8\uD55C \uC801\uC740 \uC774 \uCD1D\uC54C\uC18C\uB140\uC5D0\uAC8C
      \uB9E1\uAE30\uC138\uC694. \uC911\uC7A5\uAC11\uB3C4 \uC624\uB798 \uBC84\uD2F0\uC9C0
      \uBABB\uD569\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 7930806960182
    m_Localized: "\uBC94\uC704\uACF5\uACA9"
    m_Metadata:
      m_Items: []
  - m_Id: 7930806960183
    m_Localized: "\uB113\uC740 \uBC94\uC704\uC758 \uC801\uB4E4\uC744 \uD55C \uBC29\uC5D0
      \uC4F8\uC5B4\uBC84\uB9BD\uB2C8\uB2E4. \uC2DC\uC6D0\uD55C \uBC94\uC704 \uACF5\uACA9\uC744
      \uCCB4\uD5D8\uD558\uC138\uC694. "
    m_Metadata:
      m_Items: []
  - m_Id: 7930806960184
    m_Localized: "\uBCF4\uC870"
    m_Metadata:
      m_Items: []
  - m_Id: 7930806960185
    m_Localized: "\uACF5\uACA9\uB825\uC740 \uB0AE\uC9C0\uB9CC \uC544\uAD70\uC5D0\uAC8C
      \uC774\uB85C\uC6B4 \uD6A8\uACFC\uB97C \uC8FC\uB294 \uCD1D\uC54C\uC18C\uB140\uC785\uB2C8\uB2E4. "
    m_Metadata:
      m_Items: []
  - m_Id: 7930806960186
    m_Localized: "\uD655\uC778"
    m_Metadata:
