      m_Items: []
  - m_Id: 7930806960133
    m_Localized: "\u30D0\u30EC\u30C3\u30C8\u30AC\u30FC\u30EB\u306E\\n\u653B\u6483\u30BF\u30A4\u30D7\u3092\u78BA\u8A8D\u3067\u304D\u307E\u3059\u3002"
