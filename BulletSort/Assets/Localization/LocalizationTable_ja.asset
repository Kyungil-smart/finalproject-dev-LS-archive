      m_Items: []
  - m_Id: 7930806960132
    m_Localized: "\u6240\u6301\u3057\u3066\u3044\u308B\u30D0\u30EC\u30C3\u30C8\u30AC\u30FC\u30EB\u3067\\n\u30C7\u30C3\u30AD\u3092\u7DE8\u6210\u3057\u307E\u3057\u3087\u3046\u3002\\n6\u4EBA\u306E\u591A\u69D8\u306A\u5C11\u5973\u3067\\n\u7DE8\u6210\u3067\u304D\u307E\u3059\u3002"
