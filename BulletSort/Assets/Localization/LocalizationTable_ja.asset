  m_TableData:
  - m_Id: 7930798571520
    m_Localized: "\u8B0E\u306E\u30E2\u30F3\u30B9\u30BF\u30FC\u304C\\n\u4E16\u754C\u3092\u8105\u304B\u3057\u3066\u3044\u307E\u3059\u3002\\n\u30D0\u30EC\u30C3\u30C8\u30AC\u30FC\u30EB\u3092\u305D\u308D\u3048\u3066\\n\u30E2\u30F3\u30B9\u30BF\u30FC\u3092\u5012\u3057\u307E\u3057\u3087\u3046\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 7930798571521
    m_Localized: "\u540C\u3058\u7A2E\u985E\u306E\u30D0\u30EC\u30C3\u30C8\u30AC\u30FC\u30EB\u3092\u305D\u308D\u3048\u3088\u3046!!\\n\u30D0\u30EC\u30C3\u30C8\u30AC\u30FC\u30EB\u306E\u529B\u3067\u6575\u3092\u653B\u6483\u3057\u307E\u3059\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 7930798571522
    m_Localized: "\u3059\u3079\u3066\u306E\u30D0\u30EC\u30C3\u30C8\u30AC\u30FC\u30EB\u3092\u305D\u308D\u3048\u308B\u3068\\nPopping
      Blast!!\\n\u5F37\u529B\u306A\u30D6\u30E9\u30B9\u30C8\u3067\u6575\u5168\u4F53\u3092\u653B\u6483\u3057\u307E\u3059\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 7930806960128
    m_Localized: "\u6226\u95D8\u4E2D\u306B\u30D1\u30FC\u30AF\u3092\u9078\u3093\u3067\\n\u6226\u529B\u30A2\u30C3\u30D7!!\\n\u30D0\u30EC\u30C3\u30C8\u30AC\u30FC\u30EB\u306B\u5408\u308F\u305B\u305F\\n\u30D1\u30FC\u30AF\u304C\u51FA\u73FE\u3057\u307E\u3059\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 7930806960129
    m_Localized: "\u30CE\u30FC\u30DE\u30EB\u3001\u30A8\u30EA\u30FC\u30C8\\n\u305D\u3057\u3066\u30B9\u30C6\u30FC\u30B8\u306E\u6700\u5F8C\u306B\u306F\\n\u5F37\u529B\u306A\u30DC\u30B9\u304C\u767B\u5834\u3057\u307E\u3059\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 7930806960130
    m_Localized: "\u30B9\u30C6\u30FC\u30B8\u306B\u52DD\u5229\u3059\u308B\u3068\\n\u5F37\u5316\u3084\u30AD\u30E3\u30E9\u89E3\u653E\u306B\u5FC5\u8981\u306A\\n\u901A\u8CA8\u3092\u7372\u5F97\u3067\u304D\u307E\u3059\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 7930806960131
    m_Localized: "\u30C7\u30C3\u30AD\u7DE8\u6210\u3067\u306F\\n\u30D0\u30EC\u30C3\u30C8\u30AC\u30FC\u30EB\u3092\u914D\u7F6E\u3067\u304D\u307E\u3059\u3002"
